diff --git a/udev/revpi_mac b/udev/revpi_mac
index d0b4c0c..f438671 100755
--- a/udev/revpi_mac
+++ b/udev/revpi_mac
@@ -1,11 +1,13 @@
-#!/bin/bash
+#!/bin/sh
 
 # SPDX-FileCopyrightText: 2023 KUNBUS GmbH
 # 
 # SPDX-License-Identifier: GPL-2.0-or-later
 
-DEVNAME=$1
-OFFSET=$2
+eval $(udevadm info --query=env --export $1)
+
+DEVNAME=$ID_NET_NAME
+OFFSET=$MAC_INDEX
 
 if [ ! -f /proc/device-tree/hat/custom_5 ]; then
     exit 1
@@ -16,11 +18,16 @@ if [ -z "$BASE_MAC" ]; then
     exit 2
 fi
 
-MAC_NUM="${BASE_MAC//:/}"
-OFFSET_NUM=$(printf "%x" $((16#$MAC_NUM + $OFFSET)))
-OFFSET_MAC="$(echo "$OFFSET_NUM" | sed 's/.\{2\}/&:/g')"
-OFFSET_MAC="${OFFSET_MAC::-1}"
+MAC_NUM=$(printf "%s" "$BASE_MAC" | tr -d ':')
+DEC_NUM=$(printf "%d" "0x$MAC_NUM")
+DEC_RESULT=$((DEC_NUM + OFFSET))
+OFFSET_NUM=$(printf "%x" "$DEC_RESULT")
+OFFSET_MAC=$(printf "%s" "$OFFSET_NUM" | sed 's/../&:/g')
+OFFSET_MAC="${OFFSET_MAC%:}"
 
+echo "Setting MAC for $DEVNAME and $OFFSET"
+/sbin/ip link set "$DEVNAME" down
 /sbin/ip link set "$DEVNAME" address "$OFFSET_MAC"
+/sbin/ip link set "$DEVNAME" up
 
 exit $?
