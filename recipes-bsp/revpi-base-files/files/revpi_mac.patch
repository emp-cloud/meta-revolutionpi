diff --git a/udev/revpi_mac b/udev/revpi_mac
index c640b17..7d3605f 100755
--- a/udev/revpi_mac
+++ b/udev/revpi_mac
@@ -4,8 +4,8 @@
 # 
 # SPDX-License-Identifier: GPL-2.0-or-later
 
-DEVNAME=$1
-OFFSET=$2
+DEVNAME=${1%:*}
+OFFSET=${1##*:}
 
 # try reading MAC address from HAT EEPROM or base-mac-address file generated by
 # revpi-factory-reset(8) on devices with no HAT EEPROM
@@ -21,3 +21,3 @@
 BASE_MAC="$(grep -Ezoxm1 "([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}" \
-	"$BASE_MAC_FILE")"
+	"$BASE_MAC_FILE" | tr -d '\000')"
 if [ -z "$BASE_MAC" ]; then
@@ -31,6 +31,8 @@ OFFSET_MAC=$(printf "%x" "$DEC_RESULT" | sed 's/../&:/g')
 OFFSET_MAC="${OFFSET_MAC%:}"
 
 echo "Setting MAC for $DEVNAME and $OFFSET"
+/sbin/ip link set "$DEVNAME" down
 /sbin/ip link set "$DEVNAME" address "$OFFSET_MAC"
+/sbin/ip link set "$DEVNAME" up
 
 exit $?
