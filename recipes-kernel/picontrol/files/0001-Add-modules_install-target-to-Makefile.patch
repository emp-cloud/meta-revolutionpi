From 3419c76af3b5dc3b0aef39855ff99ea27a4fd5ed Mon Sep 17 00:00:00 2001
From: Erik Sallmann <e.sallmann@kunbus.com>
Date: Tue, 18 Nov 2025 19:56:15 +0100
Subject: [PATCH] Add modules_install target to Makefile

Need to be compliant to standard kernel module Makefiles. Therefore
makes writing of yocto recipes easier.

Signed-off-by: Erik Sallmann <e.sallmann@kunbus.com>
---
 Makefile | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/Makefile b/Makefile
index 8d330f6..af36015 100644
--- a/Makefile
+++ b/Makefile
@@ -40,3 +40,6 @@ all:
 clean:
 	$(MAKE) -C $(KDIR) M=$(PWD) clean
 	rm -f $(piControl-y)
+
+modules_install:
+	$(MAKE) -C $(KDIR) M=$(PWD) modules_install
-- 
2.53.0

